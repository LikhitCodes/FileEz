{
  "name": "p2p-file-sharing",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "package": "electron-packager . --platform=win32 --arch=x64 --out=dist/ --overwrite"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.p2p.filesharing",
    "productName": "P2P File Sharing",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "p2p.exe",
      "web/**/*",
      "data/**/*",
      "peers.txt"
    ],
    "win": {
      "target": "dir"
    },
    "nsis": {
      "oneClick": false
    },
    "compression": "store"
  }
}
